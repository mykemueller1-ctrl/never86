  "roles": {
    "ember": "Primary actions and limited brand emphasis.",
    "charcoal": "Navigation, main text and financial figures.",
    "ivory": "Reading surfaces.",
    "slate": "Information, retained draft status and light-surface keyboard focus.",
    "amber": "Needs review; paired with explicit words or signed numbers.",
