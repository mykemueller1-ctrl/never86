# Database (Neon Postgres) — free-seat persist for the 1-seat canary.
# Go-live project: "Never86 1 seat"  project_id=misty-resonance-48939769
# branch=production  branch_id=br-wispy-paper-ae1nzoch
# Phone attach: docs/NEON-ONE-SEAT-GO-LIVE.md — never commit the real URL.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Public site URL used to build magic-link activate URLs.
NEXT_PUBLIC_SITE_URL=https://www.never86.ai

# Operations DB (Supabase "never86") — live Toast data for operator reports.
# Not required for the CTAP 1-seat canary.
OPS_DATABASE_URL=postgresql://postgres.zjtbhsouhwyyfwoyjgow:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Shared password that gates /reports/* (operator report pages)
REPORTS_PASSWORD=choose-a-strong-password

# Anthropic (Claude API for invoice/z-report parsing)
ANTHROPIC_API_KEY=sk-ant-xxx

# Resend (transactional email) — REQUIRED for magic-link claim / login.
RESEND_API_KEY=re_xxx
RESEND_FROM=Never 86'd <hello@never86.ai>

# Vercel Cron Auth
CRON_SECRET=your-random-secret-here

# Notification recipient — must be deliverable.
# myke@n86.app is Resend bounce-suppressed (hard bounce 2026-07-25). Do not use it.
# Prefer mykemueller1@gmail.com (reads) or myke@never86.ai (Resend inbound).
OWNER_EMAIL=mykemueller1@gmail.com

# --- xAI / Grok + Cursor factory (placeholders only; real values stay in Vercel / .env.local) ---
XAI_API_KEY=xai-xxx
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-4.6

NEVER86_ORCHESTRATOR_TOKEN=replace-with-high-entropy-token
NEVER86_OAUTH_CLIENT_ID=grok-never86-cursor
NEVER86_OAUTH_CLIENT_SECRET=replace-with-high-entropy-secret
CURSOR_API_KEY=key_xxx
CURSOR_AUTONOMOUS_DISPATCH_ENABLED=false
CURSOR_ALLOWED_STARTING_REFS=main,codex/action-shift-122-safe
CURSOR_MAX_ACTIVE_AGENTS=1
CURSOR_REPO_URL=https://github.com/mykemueller1-ctrl/never86

# Simple Owner Demo object store (Cloudflare R2 / S3 API). Placeholders only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Staff / extra seats stay fail-closed. 1 seat CTAP only.
STAFF_SEAT_LOGIN_ENABLED=false
ONE_SEAT_CLAIM_ENABLED=true
ONE_SEAT_ALLOW_LIVE_EMAIL=true

# Free-seat magic-link activation is live when DATABASE_URL + RESEND_API_KEY are set.
# No extra boolean required. Missing mail → 503 fail-closed.

# CTAP seat 1 canary (public shop email only — no PIN, no staff name).
CTAP_SEAT1_EMAIL=communitypizza2026@gmail.com
CTAP_SEAT1_RESTAURANT=Community Tap

# House-code /portal door is enabled and fail-closed until a hash is issued.
# Store only a SHA-256 hash, never a live code, PIN, or staff name.
# CTAP strangers use /onboard email. House code is not the free-seat door.
HOUSE_CODE_HASH=
HOUSE_CODE_OPERATOR_ID=
HOUSE_CODE_PEPPER=

# Zep Graphiti / agentmemory — Bamba Lane C only. Placeholders.
ZEP_API_URL=https://api.getzep.com
ZEP_API_KEY=zep-xxx
ZEP_GRAPHITI_GROUP_ID=bamba
AGENTMEMORY_TENANT=bamba
