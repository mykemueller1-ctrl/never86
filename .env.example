# Database (Neon Postgres) — optional persist. Public /audit and /trial work without it.
# Phone attach: docs/product/NEON_PERSIST_PHONE_CHECKLIST.md — never commit the real URL.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Operations DB (Supabase "never86") — live Toast data for operator reports.
# Supabase → Project Settings → Database → Connection string → "Transaction" pooler.
OPS_DATABASE_URL=postgresql://postgres.zjtbhsouhwyyfwoyjgow:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Shared password that gates /reports/* (operator report pages)
REPORTS_PASSWORD=choose-a-strong-password

# Anthropic (Claude API for invoice/z-report parsing)
ANTHROPIC_API_KEY=sk-ant-xxx

# Resend (transactional email)
RESEND_API_KEY=re_xxx

# Vercel Cron Auth
CRON_SECRET=your-random-secret-here

# Notification recipient
OWNER_EMAIL=myke@n86.app

# --- xAI / Grok + Cursor factory (placeholders only; real values stay in Vercel / .env.local) ---
# Optional Grok *model* API. Grok Bot workspaces do not use this. See docs/company/KEYS_ACCESS.md
XAI_API_KEY=xai-xxx
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# Private Grok → Cursor factory. Never commit live values. See docs/company/GROK_CURSOR_DISPATCH.md
NEVER86_ORCHESTRATOR_TOKEN=replace-with-high-entropy-token
NEVER86_OAUTH_CLIENT_ID=grok-never86-cursor
NEVER86_OAUTH_CLIENT_SECRET=replace-with-high-entropy-secret
CURSOR_API_KEY=key_xxx
CURSOR_AUTONOMOUS_DISPATCH_ENABLED=false
CURSOR_ALLOWED_STARTING_REFS=main,codex/action-shift-122-safe
CURSOR_MAX_ACTIVE_AGENTS=1
CURSOR_REPO_URL=https://github.com/mykemueller1-ctrl/never86

# Simple Owner Demo object store (Cloudflare R2 / S3 API). Placeholders only.
# When unset, file bytes fall back to Neon simple_owner_blobs. Do not commit live keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_JURISDICTION=eu

# Staff claim stays fail-closed. Do not set true from a factory job.
STAFF_SEAT_LOGIN_ENABLED=false

# Zep Graphiti / agentmemory — Bamba Lane C only. Placeholders. No live write from factory jobs.
ZEP_API_URL=https://api.getzep.com
ZEP_API_KEY=zep-xxx
ZEP_GRAPHITI_GROUP_ID=bamba
AGENTMEMORY_TENANT=bamba
